# Copy to .env

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/procureiq
# Production: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/procureiq

# JWT (for future auth)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Agent Python backend (optional - for live agent calls)
AGENT_API_URL=http://localhost:8000
AGENT_API_KEY=

# Azure (optional - falls back to mock)
ANTHROPIC_API_KEY=sk-ant-
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_SERVICE_BUS_CONNECTION_STR=
