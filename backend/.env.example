# Copy to .env and fill in your values

# LLM — Anthropic direct (no Azure)
PROCUREMENT_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ChromaDB vector store (RAG)
PROCUREMENT_CHROMA_HOST=chromadb       # use "localhost" when running outside Docker
PROCUREMENT_CHROMA_PORT=8001
PROCUREMENT_CHROMA_COLLECTION_PREFIX=procurement

# ERP (mock mode by default — no real SAP needed)
PROCUREMENT_ERP_MOCK_MODE=true
PROCUREMENT_ERP_BASE_URL=http://localhost:8080/erp

# App
PROCUREMENT_ENVIRONMENT=development
PROCUREMENT_SHADOW_MODE=true
PROCUREMENT_LOG_LEVEL=INFO
